MONGODB_URI=
JWT_SECRET=
PORT=4000
HOST=127.0.0.1
# Use 1 only behind exactly one trusted reverse proxy with no direct public API access.
TRUST_PROXY=0
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
SANDBOX_FUNDING=true

# Optional best-effort email receipts. Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
